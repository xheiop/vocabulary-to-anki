<?xml version="1.0" encoding="UTF-8"?>
<!--
  LaunchAgent for vocab2anki. `make install` rewrites the __PLACEHOLDER__
  values below and copies this to ~/Library/LaunchAgents/com.vocab2anki.plist.
  Load it with:  launchctl load ~/Library/LaunchAgents/com.vocab2anki.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vocab2anki</string>

    <key>ProgramArguments</key>
    <array>
        <string>__BIN__</string>
        <string>-config</string>
        <string>__CONFIG__</string>
    </array>

    <!--
      PATH must include where `claude` lives (~/.local/bin by default) for the
      CLI backend. ANTHROPIC_API_KEY is only needed for the "api" backend;
      `make install` injects whatever is in your environment/.env (blank is fine
      for the default CLI backend).
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>ANTHROPIC_API_KEY</key>
        <string>__ANTHROPIC_API_KEY__</string>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>__WORKDIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/vocab2anki.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/vocab2anki.log</string>
</dict>
</plist>
